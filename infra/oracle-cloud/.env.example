# 🔐 Senhas Oracle Cloud — Planta y Raiz
# Copie para .env e gere senhas fortes:
#   openssl rand -hex 32       # chaves de criptografia
#   openssl rand -base64 24    # senhas de DB
#   openssl rand -hex 24       # API keys

ACME_EMAIL=contato@plantayraiz.com.br

# n8n
N8N_USER=admin
N8N_PASSWORD=TROCAR_SENHA_FORTE
N8N_ENCRYPTION_KEY=TROCAR_HEX_32_BYTES

# Plausible
PLAUSIBLE_DB_PASSWORD=TROCAR_SENHA_DB
PLAUSIBLE_SECRET_KEY_BASE=TROCAR_HEX_64_BYTES

# Evolution API
EVOLUTION_DB_PASSWORD=TROCAR_SENHA_DB
EVOLUTION_API_KEY=TROCAR_API_KEY_FORTE

# Webhook global (opcional — para Brisa Bot conectar no Supabase Edge Function)
# EVOLUTION_WEBHOOK_URL=https://shmbwdjuddvquszwkvuq.supabase.co/functions/v1/whatsapp-brisa-bot?token=SEU_SECRET
# EVOLUTION_WEBHOOK_ENABLED=true

# Copy to .env on the VPS (never commit .env). Values come from:
#   Supabase: Project Settings -> API (URL, keys, JWT secret)
#   each provider panel for the others (Mercado Pago, Meta, Gemini, Evolution, Jitsi...)

PUBLIC_HOST=banco.plantayraiz.com.br
SUPABASE_PROJECT_REF=

# The functions reach the database through the same public address as the site.
SUPABASE_URL=https://banco.plantayraiz.com.br
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
JWT_SECRET=

PUBLIC_SITE_URL=https://www.plantayraiz.com.br
SITE_URL=https://www.plantayraiz.com.br

# AI (Gemini free tier replaces the Lovable gateway)
GEMINI_API_KEY=

# Payments
MERCADO_PAGO_ACCESS_TOKEN=
MERCADOPAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MP_PIX_PAYOUT_ENABLED=

# WhatsApp (Evolution on this same VPS)
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
EVOLUTION_WEBHOOK_SECRET=
ADMIN_PHONE_BR=

# Video
JITSI_DOMAIN=meet.plantayraiz.com.br
JITSI_APP_ID=
JITSI_APP_SECRET=

# Meta / Instagram
META_VERIFY_TOKEN=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# Cron calls into functions (replaces LOVABLE_CRON_SECRET; keep the same name so code is unchanged)
LOVABLE_CRON_SECRET=

# Email (Hostinger mailbox SMTP is also set in Supabase Auth -> SMTP)
RESEND_API_KEY=
BREVO_API_KEY=

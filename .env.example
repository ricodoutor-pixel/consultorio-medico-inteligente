# ========================================
# PLANTA & RAIZ - ENVIRONMENT VARIABLES
# ========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ========================================
# MERCADO PAGO
# ========================================
# Get from: https://www.mercadopago.com.br/developers/panel
VITE_MERCADO_PAGO_PUBLIC_KEY=APP_USR-xxxxxxxxxxxxxxxx
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxx

# ========================================
# TWILIO
# ========================================
# Get from: https://console.twilio.com/
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_NUMBER=+5511987131241
TWILIO_SMS_NUMBER=+5511987131241

# ========================================
# JITSI MEET
# ========================================
# For self-hosted Jitsi, use your domain
# For SaaS, use meet.jitsi.si
VITE_JITSI_DOMAIN=meet.jitsi.si
VITE_JITSI_ROOM_PREFIX=plantayraiz

# ========================================
# GOOGLE MAPS
# ========================================
# Get from: https://console.cloud.google.com/
VITE_GOOGLE_MAPS_API_KEY=AIzaSyxxxxxxxxxxxxxxxx

# ========================================
# CLICKSIGN (Digital Signatures)
# ========================================
# Get from: https://app.clicksign.com/
CLICKSIGN_API_KEY=xxxxxxxxxxxxxxxx
CLICKSIGN_SANDBOX_MODE=false

# ========================================
# DATABASE
# ========================================
DATABASE_URL=mysql://user:password@localhost:3306/plantayraiz
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=password
DATABASE_NAME=plantayraiz

# ========================================
# REDIS (Cache & Sessions)
# ========================================
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ========================================
# JWT & SECURITY
# ========================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION=7d
SESSION_SECRET=your-super-secret-session-key-change-this-in-production

# ========================================
# MONITORING & LOGGING
# ========================================
# Prometheus
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
PROMETHEUS_SCRAPE_INTERVAL=15s

# Grafana
GRAFANA_ENABLED=true
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=admin

# ELK Stack
ELK_ENABLED=true
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
KIBANA_PORT=5601
LOGSTASH_PORT=5000

# Jaeger (Distributed Tracing)
JAEGER_ENABLED=true
JAEGER_AGENT_HOST=localhost
JAEGER_AGENT_PORT=6831
JAEGER_SAMPLER_TYPE=const
JAEGER_SAMPLER_PARAM=1

# ========================================
# MANUS INTEGRATIONS
# ========================================
# Manus OAuth
VITE_APP_ID=your-manus-app-id
OAUTH_SERVER_URL=https://api.manus.im
VITE_OAUTH_PORTAL_URL=https://portal.manus.im

# Manus Forge API
BUILT_IN_FORGE_API_URL=https://api.manus.im
BUILT_IN_FORGE_API_KEY=your-forge-api-key
VITE_FRONTEND_FORGE_API_URL=https://api.manus.im
VITE_FRONTEND_FORGE_API_KEY=your-frontend-forge-api-key

# Manus Analytics
VITE_ANALYTICS_ENDPOINT=https://analytics.manus.im
VITE_ANALYTICS_WEBSITE_ID=your-website-id

# ========================================
# GOOGLE ANALYTICS & TAG MANAGER
# ========================================
VITE_GOOGLE_ANALYTICS_ID=G-QY3HFCG64L
VITE_GOOGLE_TAG_MANAGER_ID=GTM-MKSBS7P

# ========================================
# EMAIL CONFIGURATION
# ========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@plantayraiz.com.br
SMTP_FROM_NAME=Planta & Raiz

# ========================================
# AWS S3 (File Storage)
# ========================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=xxxxxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxx
AWS_S3_BUCKET=plantayraiz-files
AWS_S3_ENDPOINT=https://s3.amazonaws.com

# ========================================
# PAYMENT & FINANCIAL
# ========================================
# Commission rates (as decimals)
COMMISSION_LEVEL_1=0.50
COMMISSION_LEVEL_2=0.05
COMMISSION_LEVEL_3=0.02
ADMIN_FEE=0.05
WITHDRAWAL_FEE=0.05

# ========================================
# COMPLIANCE & SECURITY
# ========================================
# ANVISA
ANVISA_ENABLED=true
ANVISA_OCR_ENABLED=true
ANVISA_RDC_660_ENABLED=true

# LGPD (Brazilian Data Protection Law)
LGPD_ENABLED=true
LGPD_DATA_RETENTION_DAYS=365

# GDPR (European General Data Protection Regulation)
GDPR_ENABLED=true
GDPR_DATA_RETENTION_DAYS=365

# ========================================
# ENVIRONMENT
# ========================================
NODE_ENV=development
VITE_APP_TITLE=Planta & Raiz
VITE_APP_LOGO=https://plantayraiz.com.br/logo.png
APP_URL=http://localhost:5173
API_URL=http://localhost:3000

# ========================================
# DEPLOYMENT
# ========================================
# Vercel
VERCEL_ENV=development
VERCEL_PROJECT_ID=

# Railway
RAILWAY_ENVIRONMENT_ID=

# Render
RENDER_SERVICE_ID=

# ========================================
# FEATURE FLAGS
# ========================================
FEATURE_TELEMEDICINE=true
FEATURE_SHOPPING=true
FEATURE_AFFILIATES=true
FEATURE_LIBRARY=true
FEATURE_AI_AGENTS=true
FEATURE_MONITORING=true
FEATURE_ANALYTICS=true

# ========================================
# DEBUG & LOGGING
# ========================================
DEBUG=false
LOG_LEVEL=info
LOG_FORMAT=json
SENTRY_DSN=

# ========================================
# RATE LIMITING
# ========================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ========================================
# CORS
# ========================================
CORS_ENABLED=true
CORS_ORIGIN=http://localhost:5173,https://plantayraiz.com.br
CORS_CREDENTIALS=true

# ========================================
# SECURITY HEADERS
# ========================================
HELMET_ENABLED=true
CSP_ENABLED=true
HSTS_ENABLED=true
HSTS_MAX_AGE=31536000

# ========================================
# BACKUP & DISASTER RECOVERY
# ========================================
BACKUP_ENABLED=true
BACKUP_FREQUENCY=daily
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE=s3

# ========================================
# OWNER INFORMATION
# ========================================
OWNER_NAME=Dr. Edilson Bezerra da Silva
OWNER_OPEN_ID=your-owner-open-id
OWNER_EMAIL=contato@plantayraiz.com.br
OWNER_PHONE=+5511987131241

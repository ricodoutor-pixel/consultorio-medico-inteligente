# Copie para .env na VPS (nunca versionar o .env preenchido).
JITSI_DOMAIN=meet.plantayraiz.com.br
# IP público da VPS Hostinger (painel Hostinger → VPS → IP).
VPS_PUBLIC_IP=
# Fixe uma versão estável publicada em https://hub.docker.com/r/jitsi/web/tags (ex.: stable-XXXX).
JITSI_IMAGE_VERSION=stable
# Mesmos valores cadastrados nos segredos do Lovable Cloud (JITSI_APP_ID / JITSI_APP_SECRET).
JITSI_APP_ID=plantayraiz
# Gerar com: openssl rand -hex 32
JITSI_APP_SECRET=
# Gerar cada uma com: openssl rand -hex 16
JICOFO_AUTH_PASSWORD=
JVB_AUTH_PASSWORD=

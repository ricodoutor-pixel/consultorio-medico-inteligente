<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 301 canonical: /tratamento → /tratamentos (evita soft 404 + consolida SEO)
  RewriteRule ^tratamento/?$ /tratamentos [R=301,L]

  # Real /api/health → Supabase Edge Function (302 redirect; Hostinger não tem mod_proxy)
  RewriteRule ^api/health/?$ https://shmbwdjuddvquszwkvuq.supabase.co/functions/v1/health [R=302,L]

  # SPA fallback
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

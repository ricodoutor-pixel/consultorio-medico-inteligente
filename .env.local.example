# Configurações de API Locais para Supabase

# SUPABASE LOCAL URLs (Após executar `supabase start`)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=eyJ... (Gerado pelo supabase start)
SUPABASE_SERVICE_ROLE_KEY=eyJ... (Gerado pelo supabase start)

# IAs
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Mercado Pago (Pagamentos / Split)
MERCADOPAGO_ACCESS_TOKEN=APP_USR-...
MERCADOPAGO_PUBLIC_KEY=APP_USR-...
MERCADOPAGO_WEBHOOK_SECRET=your_webhook_secret_here

# Twilio (SMS / WhatsApp)
TWILIO_ACCOUNT_SID=your_twilio_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# Meta / Facebook (Integração Instagram/FB)
META_GRAPH_TOKEN=EAA...
META_VERIFY_TOKEN=your_verify_token_here

# E-mail (Hostinger / Nodemailer)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=contato@plantayraiz.com.br
SMTP_PASS=your_smtp_password_here

# Webhooks / Configurações de Integração
ICP_BRASIL_WEBHOOK_URL=https://...
APP_ENV=local

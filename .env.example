# ============================================================================
# CONFIGURAÇÕES DO PROJETO
# ============================================================================

# Google Analytics
VITE_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Database
DATABASE_URL=mysql://user:password@localhost:3306/planta_raiz

# JWT
JWT_SECRET=your-secret-key-here

# OAuth
VITE_APP_ID=your-app-id
OAUTH_SERVER_URL=https://api.manus.im
VITE_OAUTH_PORTAL_URL=https://auth.manus.im

# Mercado Pago
MERCADO_PAGO_ACCESS_TOKEN=your-token
MERCADO_PAGO_PUBLIC_KEY=your-public-key

# Manus APIs
BUILT_IN_FORGE_API_URL=https://api.manus.im
BUILT_IN_FORGE_API_KEY=your-api-key
VITE_FRONTEND_FORGE_API_URL=https://api.manus.im
VITE_FRONTEND_FORGE_API_KEY=your-frontend-key

# App Info
VITE_APP_TITLE=Planta & Raiz
VITE_APP_LOGO=https://plantayraiz.com.br/logo.png

# Owner
OWNER_NAME=Planta & Raiz
OWNER_OPEN_ID=your-owner-id

# Frontend
VITE_FRONTEND_URL=https://plantayraiz.com.br

# Instagram
INSTAGRAM_ACCESS_TOKEN=your-instagram-token
INSTAGRAM_BUSINESS_ACCOUNT_ID=your-account-id

# Supabase (Fallback)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ============================================================================
# GOOGLE OAUTH (Planta y Raiz — White Label)
# ============================================================================
# IMPORTANTE: As credenciais Google NÃO ficam no .env por motivos de segurança.
# Client Secret nunca pode ser exposto no frontend (variáveis VITE_* são públicas).
#
# Configuração correta:
# 1. Crie credenciais OAuth 2.0 em https://console.cloud.google.com/apis/credentials
#    - Tipo: Web Application
#    - Nome do app: "Planta y Raiz"
#    - Origens JS autorizadas:
#        https://consultorio-medico-inteligente.lovable.app
#        https://plantayraiz.com.br
#        https://www.plantayraiz.com.br
#    - URIs de redirecionamento autorizados:
#        https://shmbwdjuddvquszwkvuq.supabase.co/auth/v1/callback
#
# 2. No painel Lovable: Cloud → Users → Authentication Settings → Google
#    Cole Client ID e Client Secret. Pronto — branding "Planta y Raiz" ativo.
#
# Não defina VITE_GOOGLE_CLIENT_ID nem VITE_GOOGLE_CLIENT_SECRET aqui.

# Manus CEO
MANUS_CEO_ENABLED=true
MANUS_CEO_LOG_LEVEL=info

# ============================================================================
# MOTOR AUTÔNOMO DE GROWTH & CRM
# ============================================================================
WAHA_API_URL=http://localhost:3000
WAHA_SESSION=default
GEMINI_API_KEY=your-google-gemini-api-key
WEBHOOK_PORT=3001

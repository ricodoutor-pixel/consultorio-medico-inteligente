# 🔐 Variáveis de ambiente — VPS Hostinger Planta y Raiz
# Copie para .env e gere senhas fortes (mínimo 32 chars).
#   openssl rand -hex 32       # para chaves
#   openssl rand -base64 24    # para senhas

# Let's Encrypt
ACME_EMAIL=contato@plantayraiz.com.br

# n8n (https://n8n.plantayraiz.com.br)
N8N_USER=admin
N8N_PASSWORD=TROCAR_SENHA_FORTE_AQUI
N8N_ENCRYPTION_KEY=TROCAR_HEX_32_BYTES_AQUI

# Plausible (https://analytics.plantayraiz.com.br)
PLAUSIBLE_DB_PASSWORD=TROCAR_SENHA_DB
PLAUSIBLE_SECRET_KEY_BASE=TROCAR_HEX_64_BYTES

# Evolution API WhatsApp (https://api.plantayraiz.com.br)
EVOLUTION_DB_PASSWORD=TROCAR_SENHA_DB
EVOLUTION_API_KEY=TROCAR_API_KEY_FORTE

<IfModule mod_mime.c>
  AddType application/xml .xml
  AddType text/xml .xml
  AddType text/plain .txt
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.xml$">
    Header set Content-Type "application/xml; charset=UTF-8"
    Header set X-Robots-Tag "noindex"
  </FilesMatch>

  # HTML / SW / manifest: NUNCA cachear (garante deploy visível na hora)
  <FilesMatch "^(index\.html|sw\.js|manifest\.json)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Bundles com hash no nome: cache longo e imutável
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Imagens/logos: revalidar sempre (logo pode ser trocado sem mudar nome)
  <FilesMatch "\.(png|jpe?g|webp|avif|svg|ico)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # Security headers
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>


<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # HTTPS redirect
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # www → sem www (canonical)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # 301 canonical: /tratamento → /tratamentos
  RewriteRule ^tratamento/?$ /tratamentos [R=301,L]

  # Real /api/health → Supabase Edge Function
  RewriteRule ^api/health/?$ https://shmbwdjuddvquszwkvuq.supabase.co/functions/v1/health [R=302,L]

  # NUNCA reescrever arquivos estáticos (.xml, .txt, .json, .ico, sitemap*, robots)
  RewriteRule \.(xml|txt|json|ico|webmanifest)$ - [L]
  RewriteRule ^sitemap.*$ - [L]
  RewriteRule ^robots\.txt$ - [L]

  # SPA fallback
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
